<Window x:Class="BnbLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BnbEmu Launcher"
        Width="1080" Height="780" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Icon="Assets/app.ico"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ 顶栏 ═══ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <!-- 应用徽标 = exe 图标（Assets/app.ico）中分辨率最高的一帧。
                     不能直接在 XAML 里写 Source="Assets/app.ico"：WPF 对多尺寸 ico
                     默认取第一帧（16×16），放大到 40px 会发虚；真正取帧见 MainWindow.xaml.cs。 -->
                <Image x:Name="AppLogo" Width="40" Height="40" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="BnbEmu Launcher" FontSize="19" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0">
                        <Run Text="Game server · " /><Run Text="{Binding RepoDisplay, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 「GitHub」文字换成图标：源文件 Assets/github-fill.svg（viewBox 1024×1024），
                     WPF 不能直接吃 SVG，这里把它的 path 原样搬成 Path.Data。
                     外面套 Viewbox + 1024 画布是为了保住原图的比例和四周留白：三个图标的墨迹
                     占比本来就不同（GitHub 满格、刷子 78%、文档满高），若改用 Stretch 按墨迹
                     缩放，三者大小会失衡。填充色绑 Button.Foreground，GhostButton 换色图标跟着变。 -->
                <Button Style="{StaticResource GhostButton}" Command="{Binding OpenRepoCommand}"
                        Margin="0,0,2,0" Padding="10,7" AutomationProperties.Name="GitHub">
                    <Button.ToolTip>
                        <ToolTip Style="{StaticResource HintToolTip}" Placement="Bottom">
                            <TextBlock Text="Open the project page on GitHub" TextWrapping="Wrap" />
                        </ToolTip>
                    </Button.ToolTip>
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="1024" Height="1024">
                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M511.6 76.3C264.3 76.2 64 276.4 64 523.5 64 718.9 189.3 885 363.8 946c23.5 5.9 19.9-10.8 19.9-22.2v-77.5c-135.7 15.9-141.2-73.9-150.3-88.9C215 726 171.5 718 184.5 703c30.9-15.9 62.4 4 98.9 57.9 26.4 39.1 77.9 32.5 104 26 5.7-23.5 17.9-44.5 34.7-60.8-140.6-25.2-199.2-111-199.2-213 0-49.5 16.3-95 48.3-131.7-20.4-60.5 1.9-112.3 4.9-120 58.1-5.2 118.5 41.6 123.2 45.3 33-8.9 70.7-13.6 112.9-13.6 42.4 0 80.2 4.9 113.5 13.9 11.3-8.6 67.3-48.8 121.3-43.9 2.9 7.7 24.7 58.3 5.5 118 32.4 36.8 48.9 82.7 48.9 132.3 0 102.2-59 188.1-200 212.9 23.5 23.2 38.1 55.4 38.1 91v112.5c0.8 9 0 17.9 15 17.9 177.1-59.7 304.6-227 304.6-424.1 0-247.2-200.4-447.3-447.5-447.3z" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Content="Open Folder" Style="{StaticResource GhostButton}" Command="{Binding OpenFolderCommand}"
                        Margin="0,0,2,0" />
                <Button Content="Settings" Style="{StaticResource SecondaryButton}" Command="{Binding OpenSettingsCommand}" />
            </StackPanel>
        </Grid>

        <!-- ═══ 启动器自更新横幅 ═══ -->
        <!-- 只在发现新版本时出现，一直留到更新完成：不做「稍后」，
             否则用户点了之后本次运行内就再也找不到入口了。
             强制更新（当前版本低于清单的 minVersion）时 CanStart / CanLaunchClient 一起变 false。 -->
        <StackPanel Grid.Row="1">

        <Border Margin="0,0,0,12" CornerRadius="10" Padding="14,10"
                Background="#FFFBEB" BorderBrush="#F0D9A4" BorderThickness="1"
                Visibility="{Binding UpdateBannerVisibility}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding UpdateTitle}" FontSize="13" FontWeight="SemiBold"
                               Foreground="#92400E" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding UpdateDetail}" FontSize="12" Foreground="#A16207"
                               TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Content="{Binding UpdateActionText}" MinWidth="132" Margin="14,0,0,0"
                        Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                        Command="{Binding UpdateActionCommand}" />
            </Grid>
        </Border>

        <!-- ═══ 卡片区 ═══ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- 源码卡片 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Source" Style="{StaticResource CardTitleText}" />
                            <TextBlock Text="·" Style="{StaticResource CardTitleText}" Margin="6,0" />
                            <TextBlock Text="{Binding RepoDisplay}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- 卡头右侧：状态徽标。检测按钮（刷新图标）就长在徽标里，尺寸跟着 12px 文案走；
                             「上次检测」时间只在检测失败时临时摆在徽标左边。 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LastCheckShortText}" Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       ToolTip="Last check time"
                                       Visibility="{Binding CheckFailedVisibility}" />
                            <!-- 前景色设在 Border 上给状态文字继承；图标按钮不继承，单独绑一次 -->
                            <Border Background="{Binding SourceBadgeBg}" CornerRadius="11" Padding="9,1,4,1"
                                    TextElement.Foreground="{Binding SourceBadgeFg}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SourceBadgeText}" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <!-- 前景色必须显式绑一次：Button 的前景色会被主题默认值顶掉，不继承 Border -->
                                    <Button Style="{StaticResource BadgeIconButton}" Margin="4,0,0,0"
                                            Command="{Binding CheckUpdateCommand}"
                                            Foreground="{Binding SourceBadgeFg}"
                                            AutomationProperties.Name="Check for updates">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource HintToolTip}" Placement="Top">
                                                <StackPanel>
                                                    <TextBlock Text="Check for updates" FontWeight="SemiBold" />
                                                    <TextBlock Text="Queries the remote repository for new commits. Read-only: nothing is downloaded or modified locally."
                                                               TextWrapping="Wrap" Opacity="0.72" Margin="0,3,0,0" />
                                                    <!-- 「上次检测」时间放在这里：只有想知道的人才会悬停上来 -->
                                                    <TextBlock Text="{Binding LastCheckText}" FontSize="11"
                                                               Opacity="0.5" Margin="0,5,0,0" />
                                                </StackPanel>
                                            </ToolTip>
                                        </Button.ToolTip>
                                        <!-- 刷新图标：来自 Assets/refresh.svg（viewBox 1024×1024），
                                             WPF 不能直接吃 SVG，这里把它的 path 原样搬成 Path.Data。
                                             原图线宽 32/1024，缩到 16px 只剩 0.5px 太细，
                                             故用同色 Stroke 补到 48 加粗（去掉 StrokeThickness 即还原原始粗细）。
                                             旋转中心取墨迹中心 (512,528)/1024 = 0.5,0.5156，避免自转时晃动。 -->
                                        <Grid Width="16" Height="16" RenderTransformOrigin="0.5,0.5156">
                                            <Grid.RenderTransform>
                                                <RotateTransform />
                                            </Grid.RenderTransform>
                                            <Viewbox Width="16" Height="16">
                                                <Canvas Width="1024" Height="1024">
                                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="48" StrokeLineJoin="Round"
                                                          Data="M 832,512 a 32,32 0 0,0 -32,32 c 0,158.784 -129.216,288 -288,288 s -288,-129.216 -288,-288 s 129.216,-288 288,-288 c 66.208,0 129.536,22.752 180.608,64 H 608 a 32,32 0 0,0 0,64 h 160 a 32,32 0 0,0 32,-32 V 192 a 32,32 0 0,0 -64,0 v 80.96 A 350.464,350.464 0 0,0 512,192 C 317.92,192 160,349.92 160,544 s 157.92,352 352,352 s 352,-157.92 352,-352 a 32,32 0 0,0 -32,-32 Z" />
                                                </Canvas>
                                            </Viewbox>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecking}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="CheckSpin">
                                                                    <Storyboard>
                                                                        <DoubleAnimation
                                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                            From="0" To="360" Duration="0:0:1.1" RepeatBehavior="Forever" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <RemoveStoryboard BeginStoryboardName="CheckSpin" />
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock Text="{Binding SourceTitle}" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SourceMessage}" Style="{StaticResource CaptionText}"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SourceMessage}" />
                        <TextBlock Text="{Binding RemoteLine}" Style="{StaticResource MutedText}"
                                   Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding RemoteLine}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Command="{Binding UpdateSourceCommand}" MinWidth="104">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Style.Triggers>
                                        <!-- 有更新时这颗按钮就变成主按钮：面、描边、模板一起换，
                                             少换一样都会和旁边真正的 PrimaryButton 差一档（明暗/顶边亮光/落影各缺一点）。 -->
                                        <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentDarkBrush}" />
                                            <Setter Property="Template" Value="{StaticResource PrimaryButtonTemplate}" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{Binding UpdateButtonText}" />
                        </Button>
                        <Button Content="Commit Details" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding ShowCommitsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 环境卡片 -->
            <!-- JDK 供应商不在这里选：主界面和「设置」两处都能改，用户很难分辨哪次生效，
                 统一收到设置对话框里（Views/SettingsWindow.xaml 的「JDK 供应商」）。 -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Runtime" Style="{StaticResource CardTitleText}" />
                        <TextBlock Text="· all installed in the launcher folder" Style="{StaticResource MutedText}" Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- JDK -->
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel ToolTip="{Binding JdkHomeText}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="JDK 21" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <Border Background="{Binding JdkBadgeBg}" CornerRadius="8" Padding="7,2" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding JdkBadgeText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding JdkBadgeFg}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding JdkText}" Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Reinstall" Style="{StaticResource LinkButton}"
                                VerticalAlignment="Center" Command="{Binding InstallJdkCommand}" />
                    </Grid>

                    <Border Grid.Row="2" Height="1" Background="{StaticResource DividerBrush}" Margin="0,12" />

                    <!-- Maven -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel ToolTip="{Binding MavenHomeText}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Maven" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <Border Background="{Binding MavenBadgeBg}" CornerRadius="8" Padding="7,2" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding MavenBadgeText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding MavenBadgeFg}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding MavenText}" Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Reinstall" Style="{StaticResource LinkButton}"
                                VerticalAlignment="Center" Command="{Binding InstallMavenCommand}" />
                    </Grid>

                    <Border Grid.Row="4" Height="1" Background="{StaticResource DividerBrush}" Margin="0,12" />

                    <!-- 客户端：只报"有没有准备好"，细节和状态圆点留在下方客户端卡片里，
                         不重复放 ClientDetail（那行说明比这行长，撑高卡片） -->
                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Client" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <Border Background="{Binding ClientBadgeBg}" CornerRadius="8" Padding="7,2" Margin="8,0,0,0">
                                <TextBlock Text="{Binding ClientBadgeText}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding ClientBadgeFg}" />
                            </Border>
                        </StackPanel>

                        <Button Grid.Column="1" Content="Repack" Style="{StaticResource LinkButton}"
                                VerticalAlignment="Center" Margin="10,0,0,0" Command="{Binding RepackClientCommand}">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource HintToolTip}" Placement="Top">
                                    <StackPanel>
                                        <TextBlock Text="Force repack resources" FontWeight="SemiBold" />
                                        <TextBlock Text="Repacks fx / CharTE / EmoTE under resource into idd/idx. Normally they are repacked only when the source folders change; this forces a rebuild."
                                                   TextWrapping="Wrap" Opacity="0.72" Margin="0,3,0,0" />
                                    </StackPanel>
                                </ToolTip>
                            </Button.ToolTip>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        </StackPanel>

        <!-- ═══ 服务 / 客户端控制条 ═══ -->
        <!-- 两张等宽卡片同处一行，统一用"两行"结构：第一行 状态圆点 + 状态文案，第二行 灰色副信息，
             按钮在右侧垂直居中。两行是为了让两张卡片的节奏一致（也跟上方 JDK / Maven / 客户端
             那几行的"主文案 + 说明"对齐），否则一张一行一张两行，顶边齐了底边就会一高一低。 -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 服务卡片 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="{Binding ServerDot}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ServerText}" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- 第二行放端口，和右边客户端卡片的资源说明对称；
                             17px 缩进让副信息跟上面状态文字的起始位置对齐。
                             Rebuild 只在产物可疑（杀软/手动删过 target）时才需要用，
                             平时启动会自己判断要不要编译 -->
                        <Grid Margin="17,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Port 3838 (game) · 47611 (passport)"
                                       Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="3838 = login / channel / room traffic, 47611 = Nexon passport login protocol" />
                            <Button Grid.Column="1" Content="Rebuild" Style="{StaticResource LinkButton}"
                                    Margin="10,0,0,0" VerticalAlignment="Center"
                                    Command="{Binding ForceRebuildCommand}"
                                    ToolTip="Delete target\classes and compile the server again from scratch" />
                        </Grid>
                    </StackPanel>

                    <!-- 启动/停止合并为一个状态按钮：文案与配色随 ServerState 切换 -->
                    <Button Grid.Column="1" Content="{Binding ServerButtonText}" MinWidth="108" Margin="12,0,0,0"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding ToggleServerCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowStopStyle}" Value="True">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="BorderBrush" Value="#F0C9C9" />
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- 客户端卡片：状态圆点 + 状态文案 + 下面一行说明都留在这儿，
                 「重新打包」在运行环境卡片里，这里只放启动动作 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="{Binding ClientDot}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ClientText}" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding ClientDetail}" Style="{StaticResource MutedText}"
                                   Margin="17,3,0,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ClientDetail}" />
                    </StackPanel>

                    <Button Grid.Column="1" Content="{Binding ClientButtonText}" MinWidth="108" Margin="12,0,0,0"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding LaunchClientCommand}"
                            Style="{StaticResource PrimaryButton}">
                        <Button.ToolTip>
                            <ToolTip Style="{StaticResource HintToolTip}" Placement="Top">
                                <StackPanel>
                                    <TextBlock Text="Launch Client" FontWeight="SemiBold" />
                                    <TextBlock Text="On first run the client folder is prepared first (pull the resource submodule, copy exe/dll, pack resources), then CA.exe is launched."
                                               TextWrapping="Wrap" Opacity="0.72" Margin="0,3,0,0" />
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ 日志标题栏 ═══ -->
        <Grid Grid.Row="3" Margin="2,18,2,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Run Log" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource ToolbarToggle}" IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                              Margin="0,0,6,0" VerticalAlignment="Center" AutomationProperties.Name="Auto-scroll">
                    <ToggleButton.ToolTip>
                        <ToolTip Style="{StaticResource HintToolTip}" Placement="Top">
                            <StackPanel>
                                <TextBlock Text="Auto-scroll" FontWeight="SemiBold" />
                                <TextBlock Text="Keeps the log pinned to the newest line. Click again to leave the view where you scrolled it."
                                           TextWrapping="Wrap" Opacity="0.72" Margin="0,3,0,0" />
                            </StackPanel>
                        </ToolTip>
                    </ToggleButton.ToolTip>

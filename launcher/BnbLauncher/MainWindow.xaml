        <!-- ═══ 日志区 ═══ -->
        <!-- 阴影放在底层空 Border 上，与上面几张卡片共用 CardShadowEffect。
             不直接给外层容器加 Effect：那会把整个 ListBox 子树先渲成纹理再模糊，
             日志高频追加 / 自动滚动时会持续重算，白白拖慢渲染。 -->
        <Grid Grid.Row="4">
            <Border Background="{StaticResource LogBgBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Effect="{StaticResource CardShadowEffect}" />
            <ListBox x:Name="LogList" Style="{StaticResource LogList}" ItemsSource="{Binding Logs}"
                     Margin="14,10" ScrollViewer.CanContentScroll="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap" Margin="0,1.5">
                            <Run Text="{Binding Time, Mode=OneWay}" Foreground="#A3AAB6" />
                            <Run Text="{Binding LevelText, Mode=OneWay}" Foreground="{Binding LevelBrush, Mode=OneWay}" />
                            <Run Text="{Binding Tag, Mode=OneWay}" Foreground="{Binding TagBrush, Mode=OneWay}"
                                 FontWeight="SemiBold" />
                            <Run Text=" " />
                            <Run Text="{Binding Text, Mode=OneWay}" Foreground="{Binding TextBrush, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ═══ 状态栏 ═══ -->
        <Grid Grid.Row="5" Margin="2,10,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 进度只有这一条：确定进度铺斜条、不确定进度跑纯色滑块，
                 形态和占位宽度全程不变，右侧状态文字不会因为相位切换而横移。
                 粗细由 ThinProgressBar 自己定（12px 外高 = 1px 描边 + 10px 内腔），
                 这里别再写 Height 覆盖它。
                 宽度 150 是模板内好几个常量的基准（内腔裁剪、滑块行程都按它算），
                 改这里要同步 Themes/Styles.xaml 里的 ThinProgressBar。 -->
            <ProgressBar Style="{StaticResource ThinProgressBar}" Width="150" Margin="0,0,10,0"
                         VerticalAlignment="Center" HorizontalAlignment="Left" Minimum="0" Maximum="100"
                         Value="{Binding ProgressValue, Mode=OneWay}"
                         IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                         Visibility="{Binding ProgressBarVisibility}" />

            <TextBlock Grid.Column="1" Text="{Binding StatusLine}" Style="{StaticResource MutedText}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Column="2" Text="{Binding AppVersionText}" Style="{StaticResource MutedText}"
                       VerticalAlignment="Center" ToolTip="{Binding BaseDirText}" />
        </Grid>
    </Grid>
</Window>
